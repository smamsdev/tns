  - actorGameObject: {fileID: 958678635}
    actorName: 
    dialoguetext: Why are you so nocturnal?
    dialogueGameObject: {fileID: 0}
  - actorGameObject: {fileID: 818301706}
    actorName: 
    dialoguetext: 'I''m not. '
    dialogueGameObject: {fileID: 0}
  - actorGameObject: {fileID: 818301706}
    actorName: 
    dialoguetext: 'Why do you wake up so early?

      What made you like this?'
    dialogueGameObject: {fileID: 0}
  - actorGameObject: {fileID: 958678635}
    actorName: 
    dialoguetext: I don't know. Just wake up.
    dialogueGameObject: {fileID: 0}
